# Copy this file to .env and fill in your actual values
# .env is git-ignored and safe for local development

# Stripe Secret Key (get from https://dashboard.stripe.com/test/apikeys)
Stripe__SecretKey=sk_test_YOUR_STRIPE_SECRET_KEY_HERE

# Azure Storage Connection String (get from Azure Portal)
# For local development, you can use Azurite: UseDevelopmentStorage=true
# For production: DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AzureStorage__ConnectionString=UseDevelopmentStorage=true
